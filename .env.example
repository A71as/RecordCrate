# Spotify API Configuration (Required)
# Copy this file to .env and fill in your actual values
# Get these from: https://developer.spotify.com/dashboard/applications
# NOTE: Client secret is kept on the backend only for security

VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Auth0 Configuration (Required for user authentication)
# Get these from: https://manage.auth0.com/dashboard
# In your Auth0 Application Settings, add these Allowed Callback URLs (comma-separated):
# http://localhost:5173/auth/callback, http://127.0.0.1:5173/auth/callback, https://your-site.netlify.app/auth/callback
# Also add the same URLs to Allowed Logout URLs and Allowed Web Origins

VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id_here

# Server Configuration (Optional)
VITE_API_BASE_URL=http://localhost:4001

# Gemini AI Configuration (Optional - for natural language search)
# NOTE: This is also kept on backend for security. Frontend doesn't need it.
# Get your API key from: https://aistudio.google.com/app/apikey
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server Environment Variables
# Copy these to server/.env (without VITE_ prefix):
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here (KEEP SECRET - server only!)
# GEMINI_API_KEY=your_gemini_api_key_here (KEEP SECRET - server only!)
# PORT=4001
# CORS_ORIGIN=http://localhost:5173
# MONGODB_URI=mongodb+srv://user:pass@cluster/db