# Spotify API Configuration (Required)
# Copy this file to .env and fill in your actual values
# Get these from: https://developer.spotify.com/dashboard/applications

VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Server Configuration (Optional)
VITE_API_BASE_URL=http://localhost:4000

# Gemini AI Configuration (Optional - for natural language search)
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server Environment Variables
# Also copy these to server/.env (without VITE_ prefix):
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# GEMINI_API_KEY=your_gemini_api_key_here
# PORT=4000
# CORS_ORIGIN=http://localhost:5173